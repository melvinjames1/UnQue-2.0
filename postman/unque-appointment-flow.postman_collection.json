          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student A2\",\n  \"email\": \"{{studentA2Email}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"role\": \"student\"\n}"
        },
        "url": "{{baseUrl}}/users/register"
      }
    },
    {
      "name": "10. Login Student A2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student A2 logged in', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('studentA2Token', body.token);",
              "pm.collectionVariables.set('studentA2Id', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{studentA2Email}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/users/login"
      }
    },
    {
      "name": "11. Student A2 books T2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Appointment T2 booked', () => pm.response.to.have.status(201));",
              "pm.test('Appointment is booked', () => pm.expect(pm.response.json().appointment.status).to.eql('booked'));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentA2Token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"professorId\": \"{{professorP1Id}}\",\n  \"time\": \"{{timeT2}}\"\n}"
        },
        "url": "{{baseUrl}}/general/book"
      }
    },
    {
      "name": "12. Professor updates the free slot",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Free slot updated', () => pm.response.to.have.status(200));",
              "pm.test('Updated slot keeps its ID', () => pm.expect(pm.response.json().availability._id).to.eql(pm.collectionVariables.get('freeAvailabilityId')));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{professorP1Token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"{{updatedSlotStart}}\",\n  \"endTime\": \"{{updatedSlotEnd}}\"\n}"
        },
        "url": "{{baseUrl}}/professor/availability/{{freeAvailabilityId}}"
      }
    },
    {
      "name": "13. Professor cancels A1 appointments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A1 appointments cancelled', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{professorP1Token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "url": "{{baseUrl}}/professor/cancel-appointments/{{studentA1Id}}"
      }
    },
    {
      "name": "14. Student A1 checks pending appointments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A1 has no pending appointments', () => pm.response.to.have.status(404));",
              "pm.test('No pending appointment message returned', () => pm.expect(pm.response.text()).to.include('You have no pending appointments'));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentA1Token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": "{{baseUrl}}/general/appointments"
      }
    }
  ]
}
